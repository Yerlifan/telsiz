# Docker derleme bağlamına gönderilmeyen dosyalar. Dockerfile yalnızca server.js, src/,
# public/, package.json ve LICENSE dosyalarını kopyalar, bu liste bağlamı küçültür ve
# kalıcı verinin, sırların ve geliştirme dosyalarının derleyiciye gitmesini önler.
# Files kept out of the Docker build context. The Dockerfile copies only server.js, src/,
# public/, package.json and LICENSE. This list keeps the context small and prevents
# persistent data, secrets and development files from reaching the builder.

# Sürüm denetimi ve depo ayarları
# Version control and repository settings
.git
.gitattributes
.gitignore
.github

# Geliştirme bağımlılıkları
# Development dependencies
node_modules
**/node_modules

# Testler, betikler ve belgeler
# Tests, scripts and documentation
test
e2e
e2e-sonuclar
scripts
docs
*.md
*.bat

# Yerel derleme çıktıları, masaüstü uygulaması ve npm paket arşivleri
# Local build outputs, the desktop app and npm package archives
dist
desktop
telsiz-*.tgz
*.sh

# Sunucunun kalıcı verisi (hesaplar, şifreli mesajlar, yüklemeler)
# Persistent server data (accounts, encrypted messages, uploads)
veri
**/veri

# Dağıtım örnekleri ve Docker dosyalarının kendisi
# Deployment examples and the Docker files themselves
deploy
Dockerfile
.dockerignore

# Günlükler, ortam dosyaları, sırlar ve sistem dosyaları
# Logs, environment files, secrets and system files
*.log
**/*.log
.env
.env.*
**/*.pem
**/*.key
.DS_Store
**/.DS_Store
