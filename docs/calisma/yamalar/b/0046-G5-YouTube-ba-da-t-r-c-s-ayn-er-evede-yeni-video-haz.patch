 public/dj/youtube.js | 58 ++++++++++++++++++++++++++++++++++--
 test/music.test.js   | 70 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 126 insertions(+), 2 deletions(-)

diff --git a/public/dj/youtube.js b/public/dj/youtube.js
index 4dc7359..b83262e 100644
--- a/public/dj/youtube.js
