 // Mert listeden düşer ve Mert'in uygulaması giriş ekranında frekanstan çıkarıldığını yazar.
 
 const { before, after } = require('node:test')
@@ -38,6 +38,20 @@ async function openMessageReport (page, messageId) {
   await page.waitForSelector('#report-dialog #report-form')
 }
 
+// Mesaj eylemleri menüsündeki (...) Mesajı Bildir öğesiyle şikâyet penceresini açar. Dokunmatik cihazlarda araç
+// çubuğu düğmeleri gizlidir (@media (hover: none)), şikâyet yalnızca bu yoldan açılır.
+async function openMessageReportFromMenu (page, messageId) {
+  const node = '#message-list .msg[data-id="' + messageId + '"]'
+  await page.waitForSelector(node, { timeout: h.LONG })
+  await page.hover(node)
+  await page.click(node + ' .msg-more')
+  await page.waitForSelector('#msg-menu:not([hidden]) #msg-menu-report:not([hidden])')
+  assert.equal((await page.textContent('#msg-menu-report')).trim(), 'Mesajı Bildir')
+  await page.click('#msg-menu-report')
+  await page.waitForSelector('#report-dialog #report-form')
+  assert.equal(await page.isHidden('#msg-menu'), true)
+}
+
