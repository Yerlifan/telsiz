 }
 
-// Sunucunun Telsiz DJ ayarı (meta.music: { enabled, youtube, restricted }, varsayılan ilk ikisi açık,
-// kısıtlı kip kapalı)
+// Sunucunun Telsiz DJ ayarı (meta.music: { enabled, youtube, restricted, search }, varsayılan ilk ikisi açık,
+// kısıtlı kip ve şarkı adıyla arama kapalı). Sunucu search alanını yalnızca DJ ve YouTube kaynağı açıkken doğru
+// verir, burada da aynı kural uygulanır.
 function musicServerSettings () {
   const m = state.meta && state.meta.music && typeof state.meta.music === 'object' ? state.meta.music : null
   const enabled = !m || m.enabled !== false
-  return { enabled: enabled, youtube: enabled && (!m || m.youtube !== false), restricted: Boolean(m && m.restricted === true) }
+  const youtube = enabled && (!m || m.youtube !== false)
+  return { enabled: enabled, youtube: youtube, restricted: Boolean(m && m.restricted === true), search: youtube && Boolean(m && m.search === true) }
 }
 
 function musicSwitchOkKey (field, checked) {
   if (field === 'enabled') return checked ? 'dj.settings.enabledOn' : 'dj.settings.enabledOff'
   if (field === 'restricted') return checked ? 'dj.settings.restrictedOn' : 'dj.settings.restrictedOff'
+  if (field === 'search') return checked ? 'dj.settings.searchOn' : 'dj.settings.searchOff'
   return checked ? 'dj.settings.youtubeOn' : 'dj.settings.youtubeOff'
 }
 
+// Şarkı adıyla aramayı açmadan önce onay penceresi: riskler yeniden gösterilir, ilk odak İptal'dedir. Yalnızca
+// "Riskleri Okudum, Aramayı Aç" ile istek gönderilir, kapatılırsa anahtar kapalı kalır.
+function musicSearchConfirm (input) {
+  openAppDialog({
+    name: 'music-search',
+    titleKey: 'settings.dj.searchConfirmTitle',
+    trigger: input,
+    build: (body, close) => {
+      body.appendChild(h('p', 'lead', t('settings.dj.searchHint')))
+      body.appendChild(h('p', 'hint', t('settings.dj.searchConfirmNote')))
+      const row = h('div', 'row dialog-actions')
+      const confirm = button('button', t('settings.dj.searchConfirm'))
+      confirm.id = 'music-search-confirm'
+      const cancel = button('button button-secondary', t('common.cancel'))
+      cancel.id = 'music-search-cancel'
+      row.appendChild(confirm)
+      row.appendChild(cancel)
+      body.appendChild(row)
+      cancel.addEventListener('click', () => close('dismiss'))
+      confirm.addEventListener('click', () => {
+        close('done')
+        input.checked = true
+        musicSwitchChange('search', true, input)
+      })
+      return cancel
+    }
+  })
+}
+
 // Anahtar değişince POST /api/settings { music: { <alan>: değer } } gönderilir. Başarısızlıkta anahtar
 // sunucudaki değere döner. Yeni değer meta güncellemesiyle (poll) gelir, DJ kartı djOnMeta ile güncellenir.
 async function musicSwitchChange (field, checked, input) {
diff --git a/test/settings.test.js b/test/settings.test.js
index 5984cc6..154bba2 100644
--- a/test/settings.test.js
+++ b/test/settings.test.js
@@ -1095,6 +1095,53 @@ test('Telsiz DJ sunucu anahtarları: yalnızca sahipte görünür ve sahipte etk
   assert.strictEqual(admin.root.querySelector('#set-music-section').hidden, true, 'yönetici görmez')
 })
 
+test('şarkı adıyla YouTube araması anahtarı: varsayılan kapalı, YouTube kapalıyken devre dışı, açarken onay penceresi', async () => {
+  const owner = load({ role: 'owner' })
+  const dialogRoot = owner.doc.createElement('div')
+  dialogRoot.id = 'dialog-root'
+  dialogRoot.hidden = true
+  owner.doc.body.appendChild(dialogRoot)
+  owner.run("openSettings('general', null)")
+  const sw = () => owner.root.querySelector('#set-music-search')
+  assert.strictEqual(sw().checked, false, 'varsayılan kapalı')
+  assert.strictEqual(sw().disabled, false)
+  assert.strictEqual(sw().getAttribute('role'), 'switch')
+  assert.ok(owner.root.querySelector('#set-music-search-hint').textContent.indexOf('Hizmet Şartları') !== -1, 'risk açıklaması')
+  const settingsPosts = () => owner.sandbox.__requests.filter((r) => r.path === '/api/settings')
+  // Açmak onay ister: İptal anahtarı kapalı bırakır ve istek göndermez
+  sw().click()
+  assert.strictEqual(sw().checked, false)
+  const dialog = () => owner.doc.querySelector('#music-search-dialog')
+  assert.ok(dialog(), 'onay penceresi açıldı')
+  assert.strictEqual(owner.doc.querySelector('#music-search-confirm').textContent, 'Riskleri Okudum, Aramayı Aç')
+  owner.doc.querySelector('#music-search-cancel').click()
+  assert.strictEqual(dialog(), null)
+  assert.strictEqual(sw().checked, false)
+  assert.strictEqual(settingsPosts().length, 0)
+  // Onay: POST /api/settings { music: { search: true } }
+  sw().click()
+  owner.doc.querySelector('#music-search-confirm').click()
+  await new Promise((resolve) => setImmediate(resolve))
+  owner.run('0')
+  assert.deepStrictEqual(JSON.parse(JSON.stringify(settingsPosts().map((r) => r.body))), [{ music: { search: true } }])
+  assert.strictEqual(sw().checked, true)
+  assert.strictEqual(owner.root.querySelector('#set-music-msg').textContent, 'Şarkı adıyla YouTube araması açıldı.')
+  // Kapatmak onay istemez
+  sw().click()
+  await new Promise((resolve) => setImmediate(resolve))
+  assert.strictEqual(dialog(), null)
+  assert.deepStrictEqual(JSON.parse(JSON.stringify(settingsPosts().map((r) => r.body))), [{ music: { search: true } }, { music: { search: false } }])
+  // YouTube kaynağı kapalıyken anahtar kapalı görünür ve devre dışıdır
+  owner.run('state.meta.music = { enabled: true, youtube: false, restricted: false, search: true }')
+  owner.run('updateSettingsPage()')
+  assert.strictEqual(sw().checked, false)
+  assert.strictEqual(sw().disabled, true)
+  owner.run('state.meta.music = { enabled: true, youtube: true, restricted: false, search: true }')
+  owner.run('updateSettingsPage()')
+  assert.strictEqual(sw().checked, true)
+  assert.strictEqual(sw().disabled, false)
+})
+
