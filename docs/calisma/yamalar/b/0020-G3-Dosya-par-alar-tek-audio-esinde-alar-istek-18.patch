Motor boyunca tek <audio> öğesi kullanılır, parça değişince yalnızca src
değişir ve her oynatıcı kendi dinleyicilerini kapanınca kaldırır. Arka
planda başlayan sonraki dosya parçası da kullanıcının oynatma izni verdiği
öğede çalar. Birim testi iki parçanın aynı öğede çaldığını ve dinleyicilerin
birikmediğini sınar. 23-dj.js baş yorumu köşedeki oynatıcının yeni hâline
göre güncellendi.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WcExsDaTGv2fcjqxWvyVHT
---
 public/js/23-dj.js | 13 ++++++++-----
 public/music.js    | 31 ++++++++++++++++++++++++++-----
 test/music.test.js | 43 ++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 76 insertions(+), 11 deletions(-)

diff --git a/public/js/23-dj.js b/public/js/23-dj.js
index be02247..81f1c50 100644
--- a/public/js/23-dj.js
+++ b/public/js/23-dj.js
@@ -17,11 +17,14 @@
 // YouTube oynatıcı alanı (.dj-yt) motora attachPlayer ile bir kez verilir ve hiç temizlenmez. Alan en az
 // 200x200 CSS pikseli ve görünürdür, üstüne hiçbir öğe konmaz (dokunarak başlat, uyarılar ve hata metinleri
 // alanın altındadır). Oynatıcı görünmezse motor YouTube parçasını bu cihazda duraklatır (music.js syncPlayer).
-// Köşedeki oynatıcı: kart görünmezken (sayfa kipinde sayfa kapalı) veya üstünü bir katman örterken (Ayarlar,
-// başka bir sayfa, menü, pencere) oynatıcı alanı yalnızca CSS sınıflarıyla köşeye sabitlenir, altında başlık,
-// duraklat ve "DJ'yi aç" düğmeleri olan küçük bir çubuk durur (djApplyLayout). Çerçeve ve ataları DOM'da hiç
-// taşınmaz (taşınan çerçeve yeniden yüklenir), kart visibility ile gizlenir. Böylece müzik ses odasından
-// ayrılana kadar çalmaya devam eder.
+// Köşedeki oynatıcı: kart görünmezken (sayfa kipinde sayfa kapalı), üstünü bir katman örterken (Ayarlar,
+// başka bir sayfa, menü, pencere) veya "Yüzen Oynatıcı" açıkken yüzen kutu (oynatıcı alanı ya da dosya
+// parçasının dalga biçimi ve altında başlık, duraklat, Taşı, Küçült ve "DJ'yi aç" düğmeleri olan çubuk)
+// yalnızca CSS sınıflarıyla dört köşeden birine sabitlenir (djApplyLayout, djPlaceDock). Kutu çubuğundan
+// sürüklenir ve en yakın köşeye oturur (dockDrag), köşe cihazda saklanır (telsiz.djDock), alt köşede yazma
+// alanının ve telsiz kartının üstüne çıkar. Küçültülen kutuda yalnızca çubuk kalır, YouTube parçası bu cihazda
+// bekletilir. Çerçeve ve ataları DOM'da hiç taşınmaz (taşınan çerçeve yeniden yüklenir), kart visibility ile
+// gizlenir. Böylece müzik ses odasından ayrılana kadar çalmaya devam eder.
 // Çizim: motorun parça ve durum olaylarında kart hemen çizilir, diğer değişiklikler bir sonraki karede
 // toplanır. Sayfa gizliyken (arka plandaki sekme, simge durumundaki pencere) tarayıcı kareleri bekletir,
 // çizim zamanlayıcıyla yapılır ve saniyelik denetim kartı her zaman çizer.
diff --git a/public/music.js b/public/music.js
index a5c1782..bf1d63a 100644
--- a/public/music.js
+++ b/public/music.js
@@ -934,13 +934,20 @@ var TelsizMusic = (function (root) {
 
   // ------------------------------------------------------------ <audio> bağdaştırıcısı
 
-  // Çözülmüş dosyayı çalar. src her zaman URL.createObjectURL ile üretilmiş blob adresidir.
-  function createAudioPlayer (env, track, url, hooks) {
-    const audio = env.createAudio()
+  // Çözülmüş dosyayı çalar. src her zaman URL.createObjectURL ile üretilmiş blob adresidir. Motor boyunca tek
+  // <audio> öğesi kullanılır (audio() her çağrıda aynı öğeyi verir), parça değişince yalnızca src değişir:
+  // arka planda başlayan sonraki parça da kullanıcının oynatma izni verdiği öğede çalar. Her oynatıcı kendi
+  // dinleyicilerini ekler ve kapanınca kaldırır.
+  function createAudioPlayer (audioOf, track, url, hooks) {
+    const audio = audioOf()
     let ready = false
     let destroyed = false
     audio.preload = 'auto'
-    const on = (name, fn) => audio.addEventListener(name, fn)
+    const handlers = []
+    const on = (name, fn) => {
+      handlers.push({ name: name, fn: fn })
+      audio.addEventListener(name, fn)
+    }
     on('loadedmetadata', () => {
       if (destroyed) return
       if (isFiniteNumber(audio.duration) && audio.duration > 0) hooks.duration(Math.round(audio.duration * 1000))
@@ -1014,6 +1021,13 @@ var TelsizMusic = (function (root) {
         } catch (e) {
           // Yoksa sessiz
         }
+        handlers.forEach((hd) => {
+          try {
+            audio.removeEventListener(hd.name, hd.fn)
+          } catch (e) {
+            // Yoksa sessiz
+          }
+        })
         try {
           audio.removeAttribute('src')
           audio.load()
@@ -1094,6 +1108,8 @@ var TelsizMusic = (function (root) {
     let decryptRetried = null
     let host = null
     let player = null
+    // Dosya parçalarının tek <audio> öğesi (ilk dosya parçasında kurulur)
+    let sharedAudio = null
     let tickHandle = null
     let leadHandle = null
     let lastPositionEvent = 0
@@ -2284,7 +2300,7 @@ var TelsizMusic = (function (root) {
         changed()
         return
       }
-      player = createAudioPlayer(env, track, result.url, hooksFor(room, track))
+      player = createAudioPlayer(audioElement, track, result.url, hooksFor(room, track))
       local.loadingTrack = null
       local.error = null
       cancelRecovery()
@@ -2293,6 +2309,11 @@ var TelsizMusic = (function (root) {
       changed()
     }
 
+    function audioElement () {
+      if (!sharedAudio) sharedAudio = env.createAudio()
+      return sharedAudio
+    }
+
     function onYouTubeEvent (ev, hooks) {
       if (!isObj(ev)) return
       if (ev.type === 'ready') hooks.ready()
diff --git a/test/music.test.js b/test/music.test.js
index 867a90d..69d6a5e 100644
--- a/test/music.test.js
+++ b/test/music.test.js
@@ -280,6 +280,10 @@ function fakeAudio (behaviour) {
       if (!listeners[name]) listeners[name] = []
       listeners[name].push(fn)
     },
+    removeEventListener: (name, fn) => {
+      listeners[name] = (listeners[name] || []).filter((x) => x !== fn)
+    },
+    listenerCount: () => Object.keys(listeners).reduce((n, k) => n + listeners[k].length, 0),
     fire: (name) => {
       const list = listeners[name] || []
       list.forEach((fn) => fn())
@@ -2170,7 +2174,9 @@ describe('inceleme bulguları: dosya indirme, kurtarma ve hata durumları', () =
     b.engine.resync()
     await flush(12)
     assert.equal(downloads, before + 1)
-    assert.equal(b.audios.length, 2)
+    // Tek <audio> öğesi: ikinci dosya da aynı öğede çalar
+    assert.equal(b.audios.length, 1)
+    assert.equal(b.audios[0].src, b.urls.created[b.urls.created.length - 1])
     assert.equal(b.engine.snapshot().player.error, null)
   })
 
@@ -3190,3 +3196,38 @@ describe('motor: yerel bekletme (setLocalHold)', () => {
     b.engine.setLocalHold('minimized', false)
   })
 })
+
+describe('motor: tek <audio> öğesi', () => {
+  test('art arda iki dosya parçası aynı öğede çalar, yalnızca src değişir, dinleyiciler birikmez', async () => {
+    const { timers, server, clients: [a, b] } = await setup()
+    await a.engine.addFile(encryptedWav(a.device, server, 2, 'bir.wav'), { durationMs: 2000 })
+    await a.engine.addFile(encryptedWav(a.device, server, 2, 'iki.wav'), { durationMs: 2000 })
+    b.sync()
+    await flush(12)
+    const audio = b.audios[0]
+    const firstSrc = audio.src
+    const listeners = audio.listenerCount()
+    audio.duration = 2
+    audio.fire('loadedmetadata')
+    audio.fire('canplay')
+    await timers.advance(M.LIMITS.startLeadFileMs + 200)
+    assert.equal(audio.paused, false)
+    // Parça bu cihazda bitti, geçiş ikinci parçaya
+    await timers.advance(2000)
+    audio.ended = true
+    audio.fire('ended')
+    await timers.advance(600)
+    a.sync()
+    b.sync()
+    await flush(12)
+    assert.equal(b.engine.snapshot().session.current.title, 'iki.wav')
+    assert.equal(b.audios.length, 1)
+    assert.notEqual(audio.src, firstSrc)
+    assert.equal(audio.listenerCount(), listeners)
+    audio.ended = false
+    audio.fire('canplay')
+    await timers.advance(M.LIMITS.startLeadFileMs + 200)
+    assert.equal(audio.paused, false)
+    assert.equal(b.engine.snapshot().player.status, 'playing')
+  })
+})
