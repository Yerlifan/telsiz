+    let failure = null
+    try {
+      const results = await viaApi(query, deadline)
+      fails = 0
+      return results
+    } catch (err) {
+      failure = err
+    }
+    if (failure && failure.reason !== 'closed' && now() < deadline) {
+      try {
+        const results = await viaPage(query, deadline)
