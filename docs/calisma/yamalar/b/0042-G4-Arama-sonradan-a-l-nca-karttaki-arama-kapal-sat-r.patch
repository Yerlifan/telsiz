diff --git a/e2e/06-dj.test.js b/e2e/06-dj.test.js
index e678427..f0bbbf9 100644
--- a/e2e/06-dj.test.js
+++ b/e2e/06-dj.test.js
@@ -392,6 +392,8 @@ test('/çal şarkı adı: arama kapalıyken hata ve YouTube arama bağlantısı,
   await A.click('#music-search-confirm')
   for (const page of [A, B]) await page.waitForFunction(() => state.meta.music.search === true, null, { timeout: h.LONG })
   assert.equal(await A.evaluate(() => document.getElementById('set-music-search').checked), true)
+  // Arama açılınca karttaki "arama kapalı" satırı kalkar
+  await A.waitForFunction(() => document.querySelector('#dj .dj-search').hidden, null, { timeout: h.LONG })
   await A.evaluate(() => closeSettings())
   await A.waitForFunction(() => !isSettingsOpen())
   // İlk sonuç başlığıyla kuyruğa eklenir, duyuru başlıkla hemen gider
diff --git a/public/js/23-dj.js b/public/js/23-dj.js
index ed81668..ac8dd5d 100644
--- a/public/js/23-dj.js
+++ b/public/js/23-dj.js
@@ -1809,7 +1809,9 @@ function djSearchMissed (query, code) {
 }
 
 function djRenderSearch (ui) {
-  const miss = dj.searchMiss && sameId(dj.searchMiss.room, dj.voiceRoom) ? dj.searchMiss : null
+  // Sahip aramayı sonradan açtıysa "arama kapalı" satırı artık gösterilmez
+  const stale = Boolean(dj.searchMiss && dj.searchMiss.code === 'search_unavailable' && djSearchOn())
+  const miss = dj.searchMiss && !stale && sameId(dj.searchMiss.room, dj.voiceRoom) ? dj.searchMiss : null
   ui.search.hidden = !dj.searching && !miss
   ui.searchLinkRow.hidden = !miss
   ui.searchOwner.hidden = !(miss && miss.code === 'search_unavailable' && isOwner())
