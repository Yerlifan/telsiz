+// Ana sürece giden değerler ve beklenen tam saniye (süzme kuralı ön yüklemede ve ana süreçte aynı)
+const IDLE_CASES = [
+  [0, 0],
+  [12, 12],
+  [12.9, 12],
+  [59.999, 59],
+  [86400 * 30, 86400 * 30],
+  [Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER],
+  [-1, 0],
+  [-0.5, 0],
+  [NaN, 0],
+  [Infinity, 0],
