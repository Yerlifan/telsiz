 test('settings.css yalnızca belirteçlerle yazılır ve eski WebKit kurallarına uyar', () => {
   const css = fs.readFileSync(path.join(PUB, 'css', 'settings.css'), 'utf8')
   const body = css.replace(/\/\*[\s\S]*?\*\//g, '')
