+  await A.waitForFunction(() => !document.querySelector('#dj .dj-search').hidden && !document.querySelector('#dj .dj-search-link-row').hidden)
+  const miss = await A.evaluate(() => {
+    const a = document.querySelector('#dj .dj-search-link')
