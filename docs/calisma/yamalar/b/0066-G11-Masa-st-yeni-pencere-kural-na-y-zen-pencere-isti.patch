diff --git a/desktop/test/guvenlik.test.js b/desktop/test/guvenlik.test.js
index 4e5cec5..d3413e2 100644
--- a/desktop/test/guvenlik.test.js
+++ b/desktop/test/guvenlik.test.js
@@ -84,3 +84,122 @@ test('açılır pencere: YouTube çerçevesinden yalnızca YouTube adresleri dı
   const main = fs.readFileSync(path.join(SRC, 'main.js'), 'utf8').replace(/\r\n/g, '\n')
