diff --git a/public/js/10-voice.js b/public/js/10-voice.js
index fa0a2da..3c6733c 100644
--- a/public/js/10-voice.js
+++ b/public/js/10-voice.js
@@ -998,6 +998,8 @@ function myStatusLine (s) {
   if (chosen === 'idle') return t('layout.status.idle')
   if (chosen === 'dnd') return t('layout.status.dnd')
   if (chosen === 'invisible') return t('layout.status.invisible')
+  // Otomatik boşta (13-profile.js myAutoIdle): elle seçilen durum Çevrimiçi, başkaları Boşta görüyor
+  if (typeof myAutoIdle === 'function' && myAutoIdle()) return t('status.autoIdle')
   return t('user.online')
 }
 
diff --git a/public/js/11-settings.js b/public/js/11-settings.js
index 71cc86a..59f3a13 100644
--- a/public/js/11-settings.js
+++ b/public/js/11-settings.js
@@ -782,7 +782,9 @@ function shownStatusOf (userId) {
   return safeCall(() => shownStatus(userId), 'offline')
 }
 
+// Kendi durumumun metni (13-profile.js myStatusLabel): otomatik boştaysam "Boşta (otomatik)"
 function chosenStatusLabel () {
+  if (typeof myStatusLabel === 'function') return safeCall(() => myStatusLabel(), '')
   const status = safeCall(() => myChosenStatus(), 'online')
   return safeCall(() => statusLabel(status), '')
 }
@@ -866,7 +868,7 @@ function myProfileSignature () {
   if (!state.me) return ''
   const id = state.me.id
   const rec = safeCall(() => profileRecord(id), null)
-  return [state.me.name, state.me.role, safeCall(() => myChosenStatus(), ''), rec ? rec.pv : '', rec && rec.profile ? JSON.stringify(rec.profile) : '', safeCall(() => avatarInfoFor(id).blobUrl, '')].join('|')
+  return [state.me.name, state.me.role, safeCall(() => myChosenStatus(), ''), safeCall(() => myAutoIdle(), false), rec ? rec.pv : '', rec && rec.profile ? JSON.stringify(rec.profile) : '', safeCall(() => avatarInfoFor(id).blobUrl, '')].join('|')
 }
 
 // 1. Hesabım: önizleme kartı, kullanıcı adı, parola, çıkış ve hesabı silme
diff --git a/public/js/13-profile.js b/public/js/13-profile.js
index cfe3ecc..13cf95f 100644
--- a/public/js/13-profile.js
+++ b/public/js/13-profile.js
@@ -413,10 +413,26 @@ function myChosenStatus () {
   return STATUS_CHOICES.indexOf(status) !== -1 ? status : 'online'
 }
 
+// Otomatik boşta (40-bosta.js, src/hub.js): elle seçtiğim durum Çevrimiçi, bu cihaz boşta bildiriyor ve sunucu beni
+// metada boşta gösteriyor. Bu cihaz etkinken sunucu beni boşta gösteremez, böylece meta henüz gelmeden de (ör. Boşta
+// seçiminden Çevrimiçi'ne dönerken) yanlış "Boşta (otomatik)" görünmez.
+function myAutoIdle () {
+  if (!state.me || myChosenStatus() !== 'online') return false
+  if (typeof idleThisDevice === 'function' && !idleThisDevice()) return false
+  const user = metaUser(state.me.id)
+  return Boolean(user && user.online === true && user.status === 'idle')
+}
+
+// Kendi durumumun metni: otomatik boştaysam "Boşta (otomatik)", değilse elle seçtiğim durum
+function myStatusLabel () {
+  return myAutoIdle() ? t('status.autoIdle') : statusLabel(myChosenStatus())
+}
+
 function userStatus (userId) {
   if (state.me && sameId(userId, state.me.id)) {
     const mine = myChosenStatus()
-    return mine === 'invisible' ? 'offline' : mine
+    if (mine === 'invisible') return 'offline'
+    return myAutoIdle() ? 'idle' : mine
   }
   const user = metaUser(userId)
   if (!user) return 'offline'
@@ -646,7 +662,7 @@ function buildProfileCard (card, userId) {
   const statusRow = h('p', 'profile-card-status')
   statusRow.setAttribute('data-status', status)
   statusRow.appendChild(statusDot(status))
-  statusRow.appendChild(h('span', 'profile-card-status-label', statusLabel(self ? myChosenStatus() : status)))
+  statusRow.appendChild(h('span', 'profile-card-status-label', self ? myStatusLabel() : statusLabel(status)))
   if (profile && profile.statusText) {
     statusRow.appendChild(h('span', 'profile-card-status-text', profile.statusText))
   }
diff --git a/test/settings.test.js b/test/settings.test.js
index b5e77f0..464bc9e 100644
--- a/test/settings.test.js
+++ b/test/settings.test.js
@@ -1012,6 +1012,39 @@ test('gizlilik: otomatik boşta anahtarı ve süresi cihazda saklanır, değişi
   assert.strictEqual(run("t('settings.privacy.autoIdleMinutes', { count: 5 })"), '5 minutes')
 })
 
+test('otomatik boşta: kendi durumum "Boşta (otomatik)" görünür, elle seçilen durum değişmez', () => {
+  const { run } = load()
+  const me = () => ({
+    auto: run('myAutoIdle()'),
+    status: run('userStatus(1)'),
+    label: run('myStatusLabel()'),
+    line: run('myStatusLine(snap())'),
+    settings: run('chosenStatusLabel()')
+  })
+  assert.deepStrictEqual(me(), { auto: false, status: 'online', label: 'Çevrimiçi', line: 'Çevrimiçi', settings: 'Çevrimiçi' })
+  // Sunucu beni boşta gösteriyor (bütün oturumlarım boşta), bu cihaz da boşta bildiriyor
+  run("state.meta.users[0].status = 'idle'")
+  assert.deepStrictEqual(me(), { auto: true, status: 'idle', label: 'Boşta (otomatik)', line: 'Boşta (otomatik)', settings: 'Boşta (otomatik)' })
+  assert.strictEqual(run('myChosenStatus()'), 'online')
+  // Bu cihaz etkinse sunucunun eski metası "otomatik" sayılmaz (ör. elle Boşta'dan Çevrimiçi'ne dönerken)
+  run('var __deviceIdle = false; function idleThisDevice () { return __deviceIdle }')
+  assert.deepStrictEqual(me(), { auto: false, status: 'online', label: 'Çevrimiçi', line: 'Çevrimiçi', settings: 'Çevrimiçi' })
+  run('__deviceIdle = true')
+  assert.strictEqual(run('myAutoIdle()'), true)
+  // Elle seçilen durumlar otomatik sayılmaz
+  run("state.me.status = 'idle'")
+  assert.deepStrictEqual(me(), { auto: false, status: 'idle', label: 'Boşta', line: 'Boşta', settings: 'Boşta' })
+  run("state.me.status = 'dnd'; state.meta.users[0].status = 'dnd'")
+  assert.strictEqual(run('myAutoIdle()'), false)
+  assert.strictEqual(run('userStatus(1)'), 'dnd')
+  run("state.me.status = 'invisible'; state.meta.users[0].status = 'offline'; state.meta.users[0].online = false")
+  assert.strictEqual(run('myAutoIdle()'), false)
+  assert.strictEqual(run('userStatus(1)'), 'offline')
+  run("I18N.setLang('en')")
+  run("state.me.status = 'online'; state.meta.users[0].status = 'idle'; state.meta.users[0].online = true")
+  assert.strictEqual(run('myStatusLabel()'), 'Idle (automatic)')
+})
+
 test('gizlilik: Telsiz DJ medya denetimleri varsayılan açık, kapatılınca telsiz.djMediaSession 0', () => {
   const { run, root, storage } = load()
   assert.strictEqual(run('SETTINGS_KEYS.djMediaSession'), 'telsiz.djMediaSession')
