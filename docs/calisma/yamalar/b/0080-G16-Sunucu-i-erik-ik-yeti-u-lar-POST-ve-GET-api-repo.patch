+  }
+  const maxReport = state.reports.reduce((max, r) => Math.max(max, r.id), 0)
+  if (!Number.isSafeInteger(state.counters.report) || state.counters.report < maxReport) {
+    if (state.counters.report !== undefined || maxReport > 0) changed = true
