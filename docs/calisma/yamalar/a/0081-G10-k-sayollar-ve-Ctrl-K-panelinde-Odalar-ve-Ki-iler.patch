+.search-quick-name {
+  overflow: hidden;
+  color: var(--text-strong);
+  font-weight: var(--weight-strong);
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.search-quick-kind {
+  color: var(--text-3);
+  font-size: var(--text-xs);
+}
