diff --git a/public/css/components.css b/public/css/components.css
index cd3f8bc..76d3be1 100644
--- a/public/css/components.css
+++ b/public/css/components.css
@@ -1431,9 +1431,23 @@
   text-overflow: ellipsis;
 }
 
-/* Gece temasında görünen frekans etiketi, diğerlerinde gizli */
+/* Odanın frekans okuması (04-meta.js channelFreqNode): İstasyonlar listesinde her temada kanal ön ayarı gibi
+   görünür, süstür ve ekran okuyuculardan gizlidir. Gece, Saha Telsizi ve Fosfor kendi biçimini çizer. */
 .channel-freq {
-  display: none;
+  display: inline-block;
+  flex: none;
+  min-width: 3.25rem;
+  padding: 0.0625rem 0.3125rem;
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-small);
+  background-color: var(--surface-sunken);
+  color: var(--text-2);
+  font-family: var(--font-mono);
+  font-size: 0.6875rem;
+  font-weight: 500;
+  line-height: 1.25rem;
+  text-align: center;
+  font-variant-numeric: tabular-nums;
 }
 
 .dm-section {
diff --git a/public/css/frekans.css b/public/css/frekans.css
index 7950084..75c42a7 100644
--- a/public/css/frekans.css
+++ b/public/css/frekans.css
@@ -1685,20 +1685,21 @@
   -webkit-overflow-scrolling: touch;
 }
 
-/* İstasyonlar listesi: iki grup (yazı ve ses odaları), her satır 44 px */
+/* İstasyonlar listesi: iki grup (yazı ve ses odaları), her satır 44 px. Grup başlığı büyük harf yerine
+   temanın etiket yazısıyla ve altında kadran çizgileriyle (bandın ölçek çizgileri, --tick) çizilir. */
 .rooms-group-title {
-  margin: 0.75rem 0.5rem 0.25rem;
+  margin: 0.75rem 0.5rem 0.375rem;
+  padding-bottom: 0.4375rem;
+  background-image: repeating-linear-gradient(90deg, var(--tick) 0, var(--tick) 1px, rgba(0, 0, 0, 0) 1px, rgba(0, 0, 0, 0) 8px);
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 100% 0.25rem;
   color: var(--text-3);
   font-family: var(--font-label);
   font-size: var(--label-size);
   font-weight: 700;
-  letter-spacing: var(--label-spacing);
+  letter-spacing: 0.02em;
   line-height: 1.3;
-  text-transform: uppercase;
-}
-
-:root[data-skin="turkuaz"] .rooms-group-title {
-  text-transform: none;
 }
 
 .rooms-list {
@@ -1871,26 +1872,40 @@
   height: 1rem;
 }
 
-/* Ses odasındaki kişiler (04-meta.js buildRoomPeople): oda satırının altında girintili liste, küçük avatar,
-   ad ve susturma ile kamera simgeleri. Konuşan kişinin avatarında canlı renkli halka. */
+/* Ses odasındaki kişiler (04-meta.js buildRoomPeople): oda satırının altında, adın hizasından başlayan yan
+   yana çipler (liste anlamı ul ve li ile korunur). Çipte küçük avatar, ad ve susturma ile kamera simgeleri, uzun
+   ad kısalır. Konuşan kişinin avatarında canlı renkli halka ve çipin kenarı canlı renkte. Eski WebKit flex gap
+   desteklemez: çipler arasındaki aralık sağ ve alt boşluktur. */
 .room-people {
+  display: flex;
+  flex-wrap: wrap;
   margin: 0 0 0.375rem;
-  padding: 0 0 0 2.125rem;
+  padding: 0.125rem 0.25rem 0 5.375rem;
   list-style: none;
 }
 
 .room-person {
   display: flex;
   align-items: center;
+  flex: none;
+  max-width: 100%;
   min-height: 1.75rem;
-  padding-right: 0.5rem;
+  margin: 0 0.25rem 0.25rem 0;
+  padding: 0.125rem 0.5rem 0.125rem 0.125rem;
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-pill);
+  background-color: var(--surface-sunken);
   color: var(--text-2);
   font-size: var(--text-sm);
 }
 
 .room-person-avatar {
   flex: none;
-  margin-right: 0.5rem;
+  margin-right: 0.375rem;
+}
+
+.room-person.is-speaking {
+  border-color: var(--live);
 }
 
 .room-person.is-speaking .room-person-avatar {
@@ -1898,8 +1913,9 @@
 }
 
 .room-person-name {
-  flex: 1 1 auto;
+  flex: 0 1 auto;
   min-width: 0;
+  max-width: 9rem;
   overflow: hidden;
   white-space: nowrap;
   text-overflow: ellipsis;
@@ -1948,12 +1964,17 @@
   margin-right: 0.25rem;
 }
 
-/* Gece temasındaki süs frekansı oda satırında (diğer temalarda gizli, components.css) */
+/* Frekans okuması oda satırında simgeden sonra (components.css .channel-freq). Ayarlı odada vurgu renginde. */
 .room-row > .channel-freq {
   min-width: 2.75rem;
   margin-right: 0.5rem;
 }
 
+.room-row.is-current > .channel-freq {
+  border-color: var(--accent-text);
+  color: var(--accent-text);
+}
+
 /* İstasyonlar düğmesi (üst çubuk): yalnızca sağ sütun görünmediğinde (kesme noktaları bölüm 9) */
 .top-rooms {
   display: none;
