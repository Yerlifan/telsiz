@@ -0,0 +1,137 @@
+/*
+  Saha Telsizi teması. Askerî sahra telsizi: zeytin yeşili gövde, turuncu sinyal, şablon etiketler.
+  Kesik çizgili şerit ayırıcılar, kare LED'ler, mat kauçuk Bas konuş ve kare köşeli telsiz gövdesi.
+  Etiketler ve saatler tek aralıklı şablon yazısıyla (Martian Mono). Süs yalnızca kenarlarda ve boş
+  alanlarda durur, metin her zaman düz zemindedir. Her seçici :root[data-skin="saha"] ile başlar.
+*/
+
+/* Gönder simgesi: yukarı ok (simge işaretlemede Gece'nin simgesidir, telefonda etiket gizlenince görünen tek işarettir) */
+:root[data-skin="saha"] .skin-gece {
+  display: inline-block;
+}
+
+/* Kesik çizgili şerit ayırıcılar: sayfa ve konuşma başlıkları, bölüm etiketlerinin sonu */
+:root[data-skin="saha"] .sheet-head,
+:root[data-skin="saha"] .convo-head {
+  border-bottom: 1px dashed var(--line-strong);
+}
+
+:root[data-skin="saha"] .section-title::after,
+:root[data-skin="saha"] .rooms-group-title::after {
+  content: "";
+  flex: 1 1 auto;
+  height: 0;
+  margin-left: 0.6rem;
+  border-top: 1px dashed var(--line-strong);
+}
+
+:root[data-skin="saha"] .rooms-group-title {
+  display: flex;
+  align-items: center;
+}
+
+/* Telsiz gövdesi: kare köşeler, kalın kasa kenarı, anten kare */
+:root[data-skin="saha"] .radio {
+  border-width: 2px;
+  border-radius: var(--radius-card);
+}
+
+:root[data-skin="saha"] .radio::before {
+  border-radius: 2px 2px 0 0;
+}
+
+:root[data-skin="saha"] .radio .radio-screen {
+  border-style: dashed;
+  border-color: var(--line-strong);
+}
+
+/* Kare LED'ler: telsiz lambası, okunmamış noktası */
+:root[data-skin="saha"] .radio-led,
+:root[data-skin="saha"] .unread-badge {
+  border-radius: 1px;
+}
+
+/* Mat kauçuk Bas konuş: degrade yok, ince çapraz doku, kalın alt dudak */
+:root[data-skin="saha"] .radio .radio-ptt {
+  border-radius: var(--radius-card);
+  background-image: repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.07) 0, rgba(0, 0, 0, 0.07) 2px, rgba(0, 0, 0, 0) 2px, rgba(0, 0, 0, 0) 5px);
+  box-shadow: 0 4px 0 var(--accent-lip);
+}
+
+:root[data-skin="saha"] .radio .radio-ptt.is-active {
+  box-shadow: 0 1px 0 var(--accent-lip), 0 0 0 3px var(--live);
+}
+
+:root[data-skin="saha"] .radio-ptt-dome {
+  border-radius: var(--radius-control);
+}
+
+/* Telsiz kartı düğmeleri: kasa vidası gibi kalın üst kenar */
+:root[data-skin="saha"] .radio .radio-button {
+  border-top-width: 3px;
+}
+
+/* Frekans etiketi: odalar kanal numarası taşır */
+:root[data-skin="saha"] .channel-freq {
+  display: inline-block;
+  flex: none;
+  min-width: 3.2rem;
+  margin-right: 0.5rem;
+  padding: 0.05rem 0.3rem;
+  border: 1px dashed var(--edge);
+  border-radius: 2px;
+  color: var(--text-3);
+  font-family: var(--font-mono);
+  font-size: 0.6875rem;
+  font-weight: 500;
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+}
+
+:root[data-skin="saha"] .station-meta .channel-freq {
+  min-width: 0;
+  margin-right: 0.375rem;
+  padding: 0;
+  border: 0;
+}
+
+/* Anahtarsız şifreli mesaj: kesik kenarlı şablon kutusu */
+:root[data-skin="saha"] .msg-notice {
+  display: inline-flex;
+  padding: 0.45rem 0.75rem;
+  border: 1px dashed var(--edge);
+  border-radius: var(--radius-control);
+  background-color: var(--surface-sunken);
+  font-style: normal;
+}
+
+/* Saatler, tuş kapakları ve gösterge yazıları şablon yazısıyla */
+:root[data-skin="saha"] .msg-time,
+:root[data-skin="saha"] .msg-hover-time,
+:root[data-skin="saha"] .kbd,
+:root[data-skin="saha"] .secret,
+:root[data-skin="saha"] .kid {
+  font-family: var(--font-mono);
+  font-weight: 500;
+}
+
+/* Profil kartı bandı: kamuflaj ağı gibi çapraz şerit */
+:root[data-skin="saha"] .profile-card-band {
+  background-image: repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.16) 0, rgba(0, 0, 0, 0.16) 6px, rgba(0, 0, 0, 0) 6px, rgba(0, 0, 0, 0) 14px);
+}
+
+/* Seviye ölçer: kare bölmeli */
+:root[data-skin="saha"] .meter-bar {
+  background-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0) 9px, var(--surface-sunken) 9px, var(--surface-sunken) 11px);
+}
+
+/* Ayarlar: seçili kategoride turuncu şerit, bölümlerde kesik üst çizgi */
+:root[data-skin="saha"] .settings-section,
+:root[data-skin="saha"] .settings-profile-form {
+  border-top: 1px dashed var(--line-strong);
+}
+
+:root[data-skin="saha"] .settings-cat[aria-current="page"] {
+  border-color: transparent;
+  box-shadow: inset 3px 0 0 var(--accent);
+}
