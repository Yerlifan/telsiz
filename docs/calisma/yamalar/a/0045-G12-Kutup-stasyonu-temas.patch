--- /dev/null
+++ b/public/css/skins/kutup.css
@@ -0,0 +1,108 @@
+/*
+  Kutup İstasyonu teması. Kutup araştırma istasyonu: buzul mavisi ve buz beyazı, parka turuncusu dikkat
+  rengi, ince harita ızgarası üstünde buzlu cam paneller. Açık mod öncelikli tasarlandı. backdrop-filter
+  her zaman @supports içinde ve öneklidir, desteklenmezse paneller opak kalır. Telefonda cam kalkar
+  (Arcade'deki gibi, sabit konumlu alt öğeler için kapsayıcı blok oluşmasın). Her seçici
+  :root[data-skin="kutup"] ile başlar.
+*/
+
+/* Gönder simgesi: kâğıt uçak (işaretlemede Turkuaz'ın simgesi) */
+:root[data-skin="kutup"] .skin-turkuaz {
+  display: inline-block;
+}
+
+/* İnce harita ızgarası: zeminde, iki yumuşak ışığın üstünde */
+:root[data-skin="kutup"] body::before {
+  background-image:
+    linear-gradient(var(--line) 1px, rgba(0, 0, 0, 0) 1px),
+    linear-gradient(90deg, var(--line) 1px, rgba(0, 0, 0, 0) 1px),
+    radial-gradient(60rem 38rem at 6% -8%, var(--bg-glow-a), var(--bg-glow-a0) 70%),
+    radial-gradient(52rem 34rem at 102% 108%, var(--bg-glow-b), var(--bg-glow-b0) 70%);
+  background-size: 3rem 3rem, 3rem 3rem, auto, auto;
+}
+
+/* Buzlu cam paneller: frekans bandı, konuşma sütunu, sol ve sağ sütun kartları */
+:root[data-skin="kutup"] .band,
+:root[data-skin="kutup"] .convo,
+:root[data-skin="kutup"] .side-card {
+  border-color: var(--line-strong);
+}
+
+@supports ((-webkit-backdrop-filter: blur(2px)) or (backdrop-filter: blur(2px))) {
+  :root[data-skin="kutup"] .band,
+  :root[data-skin="kutup"] .convo,
+  :root[data-skin="kutup"] .side-card {
+    background-color: var(--surface-1-glass);
+    -webkit-backdrop-filter: blur(16px) saturate(120%);
+    backdrop-filter: blur(16px) saturate(120%);
+  }
+}
+
+@media (max-width: 759px) {
+  :root[data-skin="kutup"] .convo,
+  :root[data-skin="kutup"] .band {
+    background-color: var(--surface-1);
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+
+/* Telsiz gövdesi: istasyon cihazı gibi yumuşak köşe, üstte turuncu şerit */
+:root[data-skin="kutup"] .radio {
+  border-radius: var(--radius-panel);
+  border-top: 3px solid var(--accent-2);
+}
+
+:root[data-skin="kutup"] .radio::before {
+  background-color: var(--accent-2);
+}
+
+/* Okunmamış noktası parka turuncusu */
+:root[data-skin="kutup"] .unread-badge {
+  background-color: var(--accent-2-text);
+}
+
+/* Bölüm etiketleri: harita koordinatı gibi tek aralıklı, ince çizgiyle uzar */
+:root[data-skin="kutup"] .section-title::after {
+  content: "";
+  flex: 1 1 auto;
+  height: 1px;
+  margin-left: 0.6rem;
+  background-color: var(--line-strong);
+}
+
+/* Ayarlı istasyon: buzul mavisi alt çizgi */
+:root[data-skin="kutup"] .station.is-tuned {
+  box-shadow: inset 0 -2px 0 var(--accent);
+}
+
+/* Anahtarsız şifreli mesaj: buz kartı */
+:root[data-skin="kutup"] .msg-notice {
+  display: inline-flex;
+  padding: 0.5rem 0.85rem;
+  border: 1px dashed var(--edge);
+  border-radius: var(--radius-card);
+  background-color: var(--surface-3);
+  font-style: normal;
+}
+
+/* Profil kartı bandı: harita ızgarası */
+:root[data-skin="kutup"] .profile-card-band {
+  background-image: linear-gradient(rgba(255, 255, 255, 0.18) 1px, rgba(0, 0, 0, 0) 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, rgba(0, 0, 0, 0) 1px);
+  background-size: 1.25rem 1.25rem;
+}
+
+/* Seviye ölçer: termometre gibi ince bölmeli */
+:root[data-skin="kutup"] .meter-bar {
+  background-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0) 14px, var(--surface-sunken) 14px, var(--surface-sunken) 15px);
+}
+
+:root[data-skin="kutup"] .meter-threshold {
+  background-color: var(--accent-2-text);
+}
+
+/* Ayarlar: seçili kategoride turuncu çizgi */
+:root[data-skin="kutup"] .settings-cat[aria-current="page"] {
+  border-color: transparent;
+  box-shadow: inset 3px 0 0 var(--accent-2);
+}
