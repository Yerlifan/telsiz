+  assert.strictEqual(run('el.composerInput.value'), 'GIZLI-TASLAK-3')
+  run("testOpen('dm', 50)")
+  assert.strictEqual(run('el.composerInput.value'), '')
+  assert.deepStrictEqual(json('testShown'), [])
