+      const a = h.post(ctx, '/api/me/recovery', owner.token, { authKey, recovery: first.setup })
+      await hold.waitHeld(1)
+      const b = h.post(ctx, '/api/me/recovery', phone.data.token, { authKey, recovery: second.setup })
