+    return { ok: false, field: null, error: identityErrorProducer(err) }
+  } finally {
+    parsed.secret.fill(0)
+    if (rk) rk.wrapKey.fill(0)
+    if (newKeys) newKeys.wrapKey.fill(0)
+    if (secretKey) secretKey.fill(0)
+  }
+}
