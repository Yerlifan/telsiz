+  assert.deepEqual(JSON.parse(JSON.stringify(run('identityState.recovery'))), { createdAt: 1700000000000, label: 'Chrome, Linux' })
+  assert.ok(run('hasIdentity()'), 'açılan kimlik bu cihazda saklandı')
+  // Kaldırma
