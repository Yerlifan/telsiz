+  sandbox.__responses['/api/recover/keys'] = [{ status: 200, data: old.keys }, { status: 200, data: fresh }]
+  sandbox.__responses['/api/recover'] = [
+    { status: 409, data: { code: 'keys_changed', error: 'x' } },
