MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

@kullanıcı adı adın altında büyük ve tek aralıklı (çağrı işareti). Bandın sağ alt köşesinde frekansın adı, kişi ses
odasındaysa o odanın frekans okuması ve QSL damgası (süs, aria-hidden). Kapak fotoğrafı kartın resim alanı olarak
kalır. Ayarlar'daki önizleme kartı aynı künyeyi taşır, kapak önizlemesi taşımaz. Kart, kişi ses odasına girip
çıkınca yenilenir (cardModKey).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WcExsDaTGv2fcjqxWvyVHT
---
 public/css/components.css | 75 +++++++++++++++++++++++++++++++++++++++
 public/i18n.js            |  2 ++
 public/js/11-settings.js  |  4 +--
 public/js/13-profile.js   | 28 ++++++++++++---
 4 files changed, 102 insertions(+), 7 deletions(-)

diff --git a/public/css/components.css b/public/css/components.css
index e3af84a..bd08b12 100644
--- a/public/css/components.css
+++ b/public/css/components.css
@@ -3289,6 +3289,70 @@ button.member:hover {
 .profile-card-band[data-color="6"] { background-color: var(--av-6); }
 .profile-card-band[data-color="7"] { background-color: var(--av-7); }
 
+/* QSL kartı (istek 10, 13-profile.js profileQsl): bandın sağ alt köşesinde frekansın adı, kişi ses odasındaysa odanın
+   frekans okuması ve QSL damgası. Kapak fotoğrafının ve renk bandının üstünde okunsun diye yüzen yüzey zeminindedir,
+   banda binen avatara (sol alt) değmez. Süstür, ekran okuyuculardan gizlidir. */
+.profile-card-band {
+  position: relative;
+}
+
+.profile-card-qsl {
+  position: absolute;
+  right: 0.75rem;
+  bottom: 0.5rem;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  max-width: calc(100% - 8rem);
+}
+
+.profile-card-qsl-station {
+  flex: 0 1 auto;
+  min-width: 0;
+  padding: 0.125rem 0.4375rem;
+  overflow: hidden;
+  border-radius: var(--radius-small);
+  background-color: var(--surface-float);
+  color: var(--text);
+  font-family: var(--font-label);
+  font-size: var(--text-xs);
+  font-weight: 700;
+  line-height: 1.25rem;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.profile-card-qsl-freq {
+  flex: none;
+  margin-left: 0.25rem;
+  padding: 0.125rem 0.375rem;
+  border-radius: var(--radius-small);
+  background-color: var(--surface-float);
+  color: var(--accent-text);
+  font-family: var(--font-mono);
+  font-size: var(--text-xs);
+  font-weight: 500;
+  line-height: 1.25rem;
+  font-variant-numeric: tabular-nums;
+}
+
+.profile-card-qsl-stamp {
+  flex: none;
+  margin-left: 0.5rem;
+  padding: 0 0.375rem;
+  border: 2px solid var(--accent-text);
+  border-radius: var(--radius-small);
+  background-color: var(--surface-float);
+  color: var(--accent-text);
+  font-family: var(--font-mono);
+  font-size: 0.8125rem;
+  font-weight: 700;
+  line-height: 1.375rem;
+  letter-spacing: 0.12em;
+  -webkit-transform: rotate(-6deg);
+  transform: rotate(-6deg);
+}
+
 /* Avatar banda biner, ad ve rol bandın altında avatarın sağında durur. Kart 18rem'den darsa (metin sütunu 9.75rem'e
    sığmazsa) ad, rol ve @kullanıcı adı avatarın altına kayar. */
 .profile-card-head {
@@ -3339,6 +3403,17 @@ button.member:hover {
   word-break: break-word;
 }
 
+/* QSL kartı: @kullanıcı adı çağrı işaretidir, adın altında büyük ve tek aralıklı */
+.profile-card-handle {
+  margin-top: 0.125rem;
+  color: var(--text-strong);
+  font-family: var(--font-mono);
+  font-size: 1.0625rem;
+  font-weight: 500;
+  letter-spacing: 0.02em;
+  line-height: 1.3;
+}
+
 .profile-card-status {
   display: flex;
   align-items: center;
