+  // Türü tutmayan dosya (PNG beklenirken başka bayt) da kalıcıdır
+  world = avatarWorld(t, [{ ok: true, bytes: new Uint8Array([1, 2, 3, 4, 5, 6, 7, 8]) }])
+  await flush()
+  t.mock.timers.tick(3600000)
