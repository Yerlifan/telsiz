Kapak inince açık profil kartı bütünüyle yeniden kurulmuyordu, kartta
sürüklenen ses düzeyi kaydırıcısı DOM'dan çıkıyordu. Artık yalnızca
kartın renk bandı yeni bantla değiştirilir, ad, durum, ses düzeyi ve
düğmeler aynı öğeler olarak kalır.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WcExsDaTGv2fcjqxWvyVHT
---
 public/js/13-profile.js | 15 +++++++++++++--
 test/settings.test.js   | 36 ++++++++++++++++++++++++++++++++++--
 test/social.test.js     | 14 ++++++++++----
 3 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/public/js/13-profile.js b/public/js/13-profile.js
index 63f1e71..6474f64 100644
--- a/public/js/13-profile.js
+++ b/public/js/13-profile.js
@@ -501,10 +501,10 @@ function dropAvatar (uploadId) {
   dropProfileImage(profileState.avatars, uploadId)
 }
 
-// Kapak geldi: yalnızca o kişinin açık kartı yeniden çizilir (kapak başka yüzeyde yoktur, profil sürümü artmaz).
+// Kapak geldi: yalnızca o kişinin açık kartındaki bant değişir (kapak başka yüzeyde yoktur, profil sürümü artmaz).
 // Ayarlar önizlemesi sayfa imzasıyla (myProfileSignature) kendiliğinden yenilenir.
 function profileCoverReady (userId) {
-  if (profileState.cardUserId !== null && sameId(profileState.cardUserId, userId)) refreshProfileCard()
+  if (profileState.cardUserId !== null && sameId(profileState.cardUserId, userId)) refreshProfileCardCover()
 }
 
 function avatarUrlOf (userId) {
@@ -845,6 +845,17 @@ function refreshProfileCard () {
   restoreFocusKey(card, focusKey)
 }
 
+// Kapak inince açık kartın yalnızca renk bandı yenilenir. Kart bütünüyle yeniden kurulmaz, böylece kartta sürüklenen
+// ses düzeyi kaydırıcısı ve odak yerinde kalır.
+function refreshProfileCardCover () {
+  const card = byId('profile-card')
+  const userId = profileState.cardUserId
+  if (!card || userId === null || card.hidden) return
+  const band = card.querySelector('.profile-card-band')
+  if (!band || band.parentNode !== card) return
+  card.replaceChild(profileCoverBand(coverUrlOf(userId, false), userColorIndex(userId)), band)
+}
+
 // Profil kimliği (istek 9): avatar solda, sağında iki satırlı bir sütun. Üst satırda görünen ad ve hemen yanında rol
 // rozetleri (ad uzunsa rozetler alt satıra kayar), alt satırda @kullanıcı adı. Profil kartı, Ayarlar'daki iki önizleme
 // kartı ve avatar menüsünün başı bu yardımcıyı kullanır, düzen components.css .profile-identity kurallarındadır.
diff --git a/test/settings.test.js b/test/settings.test.js
index b4d058c..d06db7a 100644
--- a/test/settings.test.js
+++ b/test/settings.test.js
@@ -8,8 +8,8 @@
 // CSS kuralları, index.html ile sw.js bağlantıları, ses kancaları (10-voice.js voiceHook) ve önizleme kartının
 // kimlik düzeni (ad avatarın yanında, rol ve özel rol rozetleri adın yanında) sınanır. Gerçek
 // sunucu ve tarayıcıyla yapılan doğrulama ayrıca yapılır, bu testler CI'da ayarlar görünümünün bozulmasını yakalar.
-// Profil sayfasındaki kapak fotoğrafı (istek 8): seçme, önizleme, kaydetme, kaldırma, geri alma ve kayıt sürerken
-// hazırlanması biten kapak da sınanır.
+// Profil sayfasındaki kapak fotoğrafı (istek 8): seçme, önizleme, kaydetme, kaldırma, geri alma, kayıt sürerken hazırlanması
+// biten kapak ve kapak inince profil kartında yalnızca bandın yenilenmesi de sınanır.
 
 const test = require('node:test')
 const assert = require('node:assert')
@@ -1539,3 +1539,35 @@ test('Profil kaydı sürerken yeni kapak seçilirse kayda giren kapağın önizl
   assert.strictEqual(run('settingsUi.draft.coverUrl'), 'blob:c')
   assert.strictEqual(run('settingsUi.draft.coverMode'), 'new')
 })
+
+test('kapak inince açık profil kartında yalnızca bant değişir, kartın geri kalanı yeniden kurulmaz', () => {
+  const { run, doc, sandbox } = load({ role: 'member' })
+  const card = doc.createElement('div')
+  card.id = 'profile-card'
+  card.hidden = true
+  doc.body.appendChild(card)
+  sandbox.__coverUrl = null
+  run('coverUrlOf = function () { return __coverUrl }')
+  run('openProfileCard(2, null)')
+  assert.strictEqual(card.hidden, false)
+  const band = card.querySelector('.profile-card-band')
+  assert.strictEqual(band.classList.contains('has-cover'), false)
+  const body = card.querySelector('.profile-card-body')
+  const head = card.querySelector('.profile-card-head')
+  assert.ok(body && head)
+  // Başka kişinin kapağı gelince kart değişmez
+  sandbox.__coverUrl = 'blob:ece-kapak'
+  run('profileCoverReady(3)')
+  assert.strictEqual(card.querySelector('.profile-card-band'), band)
+  // Kart sahibinin kapağı gelince bant değişir, ad, durum, ses düzeyi ve düğmeler aynı öğeler olarak kalır
+  run('profileCoverReady(2)')
+  const fresh = card.querySelector('.profile-card-band')
+  assert.notStrictEqual(fresh, band)
+  assert.strictEqual(card.firstChild, fresh, 'bant kartın başında kalır')
+  assert.strictEqual(fresh.classList.contains('has-cover'), true)
+  assert.strictEqual(fresh.querySelector('img.profile-card-cover').src, 'blob:ece-kapak')
+  assert.strictEqual(card.querySelectorAll('.profile-card-band').length, 1)
+  assert.strictEqual(card.querySelector('.profile-card-body'), body)
+  assert.strictEqual(card.querySelector('.profile-card-head'), head)
+  assert.strictEqual(body.parentNode, card)
+})
