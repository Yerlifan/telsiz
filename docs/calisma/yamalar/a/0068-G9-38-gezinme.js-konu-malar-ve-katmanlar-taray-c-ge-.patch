+  assert.deepStrictEqual(json('[testCalls, testView, state.channelId]'), [[], 'channel', 11])
+  hist.user(1)
+  await settle()
+  hist.entries[0].state.telsiz.u = 1
+  // Kilitli katman (kurtarma kodu penceresi): geçmiş eski yerine döner, katman açık kalır
