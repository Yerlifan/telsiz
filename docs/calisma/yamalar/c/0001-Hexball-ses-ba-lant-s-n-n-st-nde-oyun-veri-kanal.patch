+test('bağlantı yeniden kurulunca iki tarafta link-close gelir, yeni peer-ready sonrası bağ yeniden açılır', async () => {
+  const room = await twoRoom()
+  const A = room.engines.A
+  const B = room.engines.B
+  await openLink(room)
+  const oldSid = room.sidOf('B', 'A')
+  // Kurulu bağlantıda ICE düşer, B'nin yeniden başlatma teklifini sunucu bir kez 400 ile reddeder: B bağlantıyı
+  // yeni sid ile yeniden kurar. Teklifte veri bölümü zaten anlaşılmış olduğundan oyun bağı engellenmez.
+  let refused = 0
+  room.rule = (en) => {
+    if (en.from === 'B' && en.type === 'offer' && refused === 0) {
+      refused++
+      return { status: 400 }
+    }
+    return null
+  }
+  room.pc('A', 'B').setConn('failed')
+  room.pc('B', 'A').setConn('failed')
+  await room.advance(3000)
+  room.rule = null
+  assert.equal(refused, 1)
+  assert.notEqual(room.sidOf('B', 'A'), oldSid)
+  assert.deepEqual(room.game('A', ['link-open', 'link-close', 'link-failed', 'peer-ready']), [
+    ['peer-ready', B.peerId], ['link-open', B.peerId], ['link-close', B.peerId], ['peer-ready', B.peerId]
+  ])
+  assert.deepEqual(room.game('B', ['link-open', 'link-close', 'link-failed', 'peer-ready']), [
+    ['peer-ready', A.peerId], ['link-open', A.peerId], ['link-close', A.peerId], ['peer-ready', A.peerId]
+  ])
+  assert.equal(B.voice.gameLinkState(A.peerId), 'none')
+  assert.equal(A.voice.gameLinkState(B.peerId), 'none')
+  // Yeni bağlantıda veri bölümü yoktur, açmak yeniden anlaşma ister
+  assert.ok(!/m=application/.test(room.offers('B', 'A').slice(-1)[0].sdp))
+  await openLink(room)
+  assert.match(room.offers('B', 'A').slice(-1)[0].sdp, /\r\nm=application 9 /)
+  assert.equal(B.voice.sendGameData(A.peerId, new Uint8Array([9])), true)
+  await room.advance(50)
+  assert.deepEqual(A.data.map((d) => d.bytes), [[9]])
+  noNegotiationErrors(room, 'A')
+  noNegotiationErrors(room, 'B')
+  await room.leaveAll()
+})
