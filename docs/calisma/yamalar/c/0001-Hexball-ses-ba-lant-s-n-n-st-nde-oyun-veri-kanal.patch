+test('kişi odadan çıkınca link-close peer-leave olayından önce gelir, ayrılan tarafta link-close sonra reset gelir', async () => {
+  const room = makeRoom()
+  room.add('A')
+  room.add('B')
+  room.add('C')
+  await room.join('A')
+  await room.join('B')
+  await room.join('C')
+  await room.advance(1500)
+  const A = room.engines.A
+  const B = room.engines.B
+  const C = room.engines.C
+  // A ev sahibi gibi B ve C ile bağ açar
+  assert.equal(A.voice.openGameLink(B.peerId), 'ok')
+  assert.equal(A.voice.openGameLink(C.peerId), 'ok')
+  await room.advance(1000)
+  assert.equal(A.voice.gameLinkState(B.peerId), 'open')
+  assert.equal(A.voice.gameLinkState(C.peerId), 'open')
+  // Sunucu B'yi çıkarır
+  room.serverDrop('B')
+  await room.advance(500)
+  const forB = A.game.filter((ev) => ev.peerId === B.peerId).map((ev) => ev.type)
+  assert.deepEqual(forB.slice(-2), ['link-close', 'peer-leave'])
+  assert.equal(forB.filter((x) => x === 'link-close').length, 1)
+  const bTypes = B.game.map((ev) => ev.type)
+  assert.deepEqual(bTypes.slice(-2), ['link-close', 'reset'])
+  // C ayrılır
+  await C.voice.leave()
+  await room.advance(500)
+  const forC = A.game.filter((ev) => ev.peerId === C.peerId).map((ev) => ev.type)
+  assert.deepEqual(forC.slice(-2), ['link-close', 'peer-leave'])
+  assert.equal(forC.filter((x) => x === 'link-close').length, 1)
+  assert.deepEqual(C.game.map((ev) => ev.type).slice(-2), ['link-close', 'reset'])
+  assert.equal(A.voice.gameLinkState(C.peerId), 'none')
+  assert.deepEqual(room.clock.errors.map(String), [])
+  await room.leaveAll()
+})
