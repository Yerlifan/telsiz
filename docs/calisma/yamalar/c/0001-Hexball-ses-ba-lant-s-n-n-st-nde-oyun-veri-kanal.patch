+test('yalnız veri bölümünü ekleyen yanıt uygulanamazsa ekran hatası verilmez, bağ engellenir, paylaşım izlenebilir kalır', async () => {
+  // B ekran paylaşıyor (izleyen yok). B, veri bölümünü ilk kez ekleyen yanıtı uygulayamaz. m satırı sayımı veri
+  // bölümünü sayaydı bu, ekran m satırı ekleyen bir anlaşmanın başarısızlığı sayılıp A'ya ekran gönderimi kapanır
+  // ve screen_negotiation_failed bildirilirdi.
+  let failing = true
+  const room = await twoRoom(null, { failAnswer: (p, pc) => failing && hasData(p) && !pcHasData(pc) })
+  const A = room.engines.A
+  const B = room.engines.B
+  const shared = B.voice.startScreenShare({ audio: false })
+  await room.advance(100)
+  await shared
+  await room.advance(500)
+  assert.ok(room.remote('A', 'B'), 'A paylaşımı görür')
+  const t0 = room.clock.now()
+  assert.equal(B.voice.openGameLink(A.peerId), 'ok')
+  await room.advance(5000)
+  assert.deepEqual(room.links('B'), [['link-failed', A.peerId, A.userId]])
+  assert.deepEqual(room.links('A'), [])
+  assert.equal(B.voice.openGameLink(A.peerId), 'blocked')
+  assert.equal(B.voice.gameLinkState(A.peerId), 'none')
+  noNegotiationErrors(room, 'B')
+  noNegotiationErrors(room, 'A')
+  // Bağlantı bir kez yeniden kuruldu, yeniden kurulum döngüsü yok, sonraki tekliflerde veri bölümü yok
+  await room.advance(60000)
+  assert.ok(room.pcsOf('B').length <= 2 && room.pcsOf('A').length <= 2, room.pcsOf('B').length + ' ' + room.pcsOf('A').length)
+  const later = room.offers('B', 'A').filter((s) => s.t > t0 + 1000).concat(room.offers('A', 'B').filter((s) => s.t > t0 + 1000))
+  assert.ok(later.every((s) => !/m=application/.test(s.sdp)), JSON.stringify(later.map((s) => s.sdp)))
+  const c = consistent(room, 'A', 'B')
+  assert.ok(c.ok, JSON.stringify(c))
+  assert.ok((await room.micGaps('A', 'B', 2000, 500)).every((d) => d > 0))
+  assert.ok((await room.micGaps('B', 'A', 2000, 500)).every((d) => d > 0))
+  // Paylaşım bu eşe kısıtlanmadı: A izleyince görüntü gelir
+  assert.equal(A.voice.watchScreen(B.userId), null)
+  await room.advance(4000)
+  assert.equal(room.remote('A', 'B').status, 'live')
+  assert.ok(room.framesIn('A', 'B') > 0)
+  // Ses oturumu yenilenince engel kalkar
+  failing = false
+  await B.voice.leave()
+  await room.advance(1000)
+  await room.join('B')
+  await room.advance(1500)
+  await openLink(room)
+  assert.deepEqual(room.clock.errors.map(String), [])
+  await room.leaveAll()
+})
