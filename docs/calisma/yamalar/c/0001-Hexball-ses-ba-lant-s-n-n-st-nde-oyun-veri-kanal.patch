+test('openGameLink: tek yeniden anlaşmayla veri bölümü eklenir, iki tarafta bir kez link-open gelir, mikrofon sürer', async () => {
+  const room = await twoRoom()
+  const A = room.engines.A
+  const B = room.engines.B
+  const offersB = room.offers('B', 'A').length
+  const offersA = room.offers('A', 'B').length
+  const sid = room.sidOf('B', 'A')
+  assert.ok(!/m=application/.test(room.offers('B', 'A')[0].sdp), 'ilk teklifte veri bölümü yok')
+  assert.equal(B.voice.gameLinkState(A.peerId), 'none')
+  assert.equal(B.voice.openGameLink(A.peerId), 'ok')
+  assert.equal(B.voice.gameLinkState(A.peerId), 'connecting')
+  // Açılırken yeniden çağrı aynı kanalı kullanır
+  assert.equal(B.voice.openGameLink(A.peerId), 'ok')
+  await room.advance(500)
+  assert.deepEqual(room.links('B'), [['link-open', A.peerId, A.userId]])
+  assert.deepEqual(room.links('A'), [['link-open', B.peerId, B.userId]])
+  assert.equal(B.voice.gameLinkState(A.peerId), 'open')
+  assert.equal(A.voice.gameLinkState(B.peerId), 'open')
+  assert.equal(B.voice.openGameLink(A.peerId), 'open')
+  assert.equal(A.voice.openGameLink(B.peerId), 'open')
+  // Tam bir yeni teklif (veri bölümüyle), aynı bağlantıda, karşı taraf teklif etmedi
+  const newOffers = room.offers('B', 'A').slice(offersB)
+  assert.equal(newOffers.length, 1)
+  assert.match(newOffers[0].sdp, /\r\nm=application 9 /)
+  assert.equal(newOffers[0].sid, sid)
+  assert.equal(room.offers('A', 'B').length, offersA)
+  assert.match(room.answers('A', 'B').slice(-1)[0].sdp, /\r\nm=application 9 /)
+  // Kanal ayarları: etiket, sırasız, yeniden göndermesiz, her iki tarafta tek kanal
+  const chB = room.channels('B', 'A')
+  const chA = room.channels('A', 'B')
+  assert.equal(chB.length, 1)
+  assert.equal(chA.length, 1)
+  assert.deepEqual([chB[0].label, chB[0].ordered, chB[0].maxRetransmits], [LABEL, false, 0])
+  assert.deepEqual([chA[0].label, chA[0].ordered, chA[0].maxRetransmits], [LABEL, false, 0])
+  assert.equal(chA[0].binaryType, 'arraybuffer')
+  const c = consistent(room, 'A', 'B')
+  assert.ok(c.ok, JSON.stringify(c))
+  assert.ok((await room.micGaps('A', 'B', 2000, 500)).every((d) => d > 0))
+  assert.ok((await room.micGaps('B', 'A', 2000, 500)).every((d) => d > 0))
+  noNegotiationErrors(room, 'A')
+  noNegotiationErrors(room, 'B')
+  assert.deepEqual(room.clock.errors.map(String), [])
+  await room.leaveAll()
+})
