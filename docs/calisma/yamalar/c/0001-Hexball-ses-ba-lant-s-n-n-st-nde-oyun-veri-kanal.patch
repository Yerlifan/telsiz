+      const e = engines[name]
+      clock.setTimeout(() => e.voice.handleMeta({ voice: { [CH]: list } }, { id: e.userId }), 20)
+    })
+  }
+
+  async function serverApi (e, method, url, body) {
+    if (url === '/api/voice/join') {
+      e.peerId = 'peer' + e.name + e.joins
+      e.joins++
+      const members = roster.map((m) => ({ peerId: m.peerId, userId: m.userId, muted: false, deafened: false }))
+      roster.push({ peerId: e.peerId, userId: e.userId })
+      pushMeta()
+      return { status: 200, data: { ok: true, peerId: e.peerId, members, iceServers: [] } }
+    }
+    if (url === '/api/voice/leave') {
+      const i = roster.findIndex((m) => m.peerId === e.peerId)
+      if (i >= 0) roster.splice(i, 1)
+      pushMeta()
+      return { status: 200, data: { ok: true } }
+    }
+    if (url === '/api/voice/state') return { status: 200, data: { ok: true } }
+    if (url === '/api/voice/signal') {
+      const d = open(body.data).value.d
+      const target = Object.keys(engines).map((k) => engines[k]).find((x) => x.peerId === body.to)
+      const entry = { t: clock.now(), from: e.name, to: target ? target.name : null, type: d.type, n: d.n, o: d.o, sid: d.sid, sdp: d.sdp || null }
+      e.sent.push(entry)
+      room.signals++
+      if (room.signals > 2000) return { status: 429, data: null }
+      const rule = room.rule ? room.rule(entry) : null
+      if (rule && typeof rule.status === 'number') return { status: rule.status, data: null }
+      if (!target) return { status: 200, data: { ok: true } }
+      const key = e.name + '>' + target.name
+      const at = Math.max(clock.now() + 20, (room.lastAt[key] || 0) + 1)
+      room.lastAt[key] = at
+      sigSeq++
+      const sig = { seq: sigSeq, from: e.peerId, data: body.data }
+      clock.setTimeout(() => target.voice.handleSignals([sig]), at - clock.now())
+      return { status: 200, data: { ok: true } }
+    }
+    return { status: 200, data: { ok: true } }
+  }
+
+  room.add = function (name, opts) {
+    const eo = opts || {}
+    const rtc = engineRtc(name, eo)
+    const win = {
+      isSecureContext: true,
+      setTimeout: clock.setTimeout,
+      clearTimeout: clock.clearTimeout,
+      setInterval: clock.setInterval,
+      clearInterval: clock.clearInterval,
+      Date: clock.Date,
+      console: { log: noop, warn: noop, error: noop },
+      addEventListener: noop,
+      removeEventListener: noop,
+      crypto: {
+        getRandomValues (b) {
+          let i = 0
+          while (i < b.length) {
+            rnd = (rnd * 1103515245 + 12345) % 2147483648
+            b[i] = rnd % 256
+            i++
+          }
+          return b
+        }
+      }
+    }
+    win.window = win
+    win.document = { visibilityState: 'visible', documentElement: element('html'), body: element('body'), createElement: element, addEventListener: noop, removeEventListener: noop }
+    const md = {
+      getUserMedia: () => Promise.resolve(new FStream([new FTrack('audio')])),
+      enumerateDevices: () => Promise.resolve([]),
+      getDisplayMedia: (c) => Promise.resolve(new FStream(c && c.audio ? [new FTrack('video'), new FTrack('audio')] : [new FTrack('video')]))
+    }
+    win.navigator = { mediaDevices: md }
+    win.MediaStream = FStream
+    win.RTCPeerConnection = rtc.FakePC
+    win.RTCRtpSender = rtc.FSender
+    win.RTCRtpReceiver = rtc.FReceiver
+    vm.createContext(win)
+    vm.runInContext(VOICE, win, { filename: 'voice.js' })
+    const e = { name, userId: String(Object.keys(engines).length + 1), peerId: null, joins: 1, screen: [], camera: [], game: [], data: [], sent: [] }
+    e.voice = win.VoiceClient.create({
+      api: (m, p, b) => serverApi(e, m, p, b),
+      seal,
+      open,
+      onScreenEvent: (ev) => e.screen.push(Object.assign({ t: clock.now() }, plain(ev))),
+      onCameraEvent: (ev) => e.camera.push(Object.assign({ t: clock.now() }, plain(ev))),
+      onGameEvent: (ev) => e.game.push(Object.assign({ t: clock.now() }, plain(ev))),
+      onGameData: (peerId, userId, data) => {
+        e.data.push({
+          t: clock.now(),
+          peerId,
+          userId,
+          isBuffer: Object.prototype.toString.call(data) === '[object ArrayBuffer]',
+          bytes: Array.from(new Uint8Array(data))
+        })
+        if (eo.throwData) throw new Error('veri dinleyicisi hatası')
+      },
+      storage: null
+    })
+    engines[name] = e
+    return e
+  }
+
+  // priv: özel arama kipinde katılır (sinyaller aynı biçimde mühürlenir, kimlik denetimi özel kipe göredir)
+  room.join = async function (name, priv) {
+    const e = engines[name]
+    e.voice.handleMeta({ voice: {} }, { id: e.userId })
+    const p = e.voice.join(CH, priv ? { private: { seal, open } } : undefined)
+    await clock.advance(100)
+    await p
+    await clock.advance(400)
+  }
+
+  room.serverDrop = function (name) {
+    const e = engines[name]
+    const i = roster.findIndex((m) => m.peerId === e.peerId)
+    if (i >= 0) roster.splice(i, 1)
+    pushMeta()
+  }
+
+  room.advance = (ms) => clock.advance(ms)
+
+  room.pc = function (name, other) {
+    let found = null
+    net.pcs.forEach((pc) => {
+      const r = net.pcs.get(pc.remotePcId)
+      if (pc.owner === name && !pc.closed && r && r.owner === other) found = pc
+    })
+    return found
+  }
+  room.pcsOf = (name) => Array.from(net.pcs.values()).filter((pc) => pc.owner === name)
+
+  room.micIn = function (name, other) {
+    const pc = room.pc(name, other)
+    return pc && pc.ml[0] ? pc.ml[0].receiver.stats.packets : 0
+  }
+  room.framesIn = function (name, other) {
+    const pc = room.pc(name, other)
+    if (!pc) return 0
+    return pc.trs.filter((t) => t.kind === 'video').reduce((n, t) => n + t.receiver.stats.frames, 0)
+  }
+  room.remote = function (name, other) {
+    const r = engines[name].voice.snapshot().screen.remote[engines[other].userId]
+    return r ? { status: r.status, watching: r.watching } : null
+  }
+  room.offers = (name, other) => engines[name].sent.filter((s) => s.type === 'offer' && s.to === other)
+  room.answers = (name, other) => engines[name].sent.filter((s) => s.type === 'answer' && s.to === other)
+  room.sidOf = function (from, to) {
+    const list = engines[from].sent.filter((s) => s.to === to)
+    return list.length ? list[list.length - 1].sid : null
+  }
+  // Oyun bağı olayları (link-*) ve isteğe bağlı başka türler, yalnız tür ve kimlik
+  room.links = (name) => engines[name].game.filter((ev) => /^link-/.test(ev.type)).map((ev) => [ev.type, ev.peerId, ev.userId])
+  room.game = (name, types) => engines[name].game.filter((ev) => types.indexOf(ev.type) >= 0).map((ev) => [ev.type, ev.peerId])
+  // name'in other ile bağlantısındaki açık veya açılmakta olan kanallar
+  room.channels = function (name, other) {
+    const pc = room.pc(name, other)
+    return pc ? pc.channels.filter((ch) => ch.readyState !== 'closed') : []
+  }
+
+  room.micGaps = async function (name, other, totalMs, stepMs) {
+    const out = []
+    let prev = room.micIn(name, other)
+    let t = 0
+    while (t < totalMs) {
+      await clock.advance(stepMs)
+      t += stepMs
+      const cur = room.micIn(name, other)
+      out.push(cur - prev)
+      prev = cur
+    }
+    return out
+  }
+
+  room.leaveAll = async function () {
+    Object.keys(engines).forEach((k) => {
+      try {
+        engines[k].voice.teardown()
+      } catch (e) {}
+    })
+    await clock.advance(2000)
+  }
+  return room
+}
+
+// İki kişilik oda: A önce katılır (yanıtlayan, kibar eş), B sonra katılır (başlatıcı, kaba eş). Eş kimlikleri
+// peerA1 ve peerB1, A'nınki küçüktür.
+async function twoRoom (optsA, optsB, priv) {
+  const room = makeRoom()
+  room.add('A', optsA)
+  room.add('B', optsB)
+  await room.join('A', priv)
+  await room.join('B', priv)
+  await room.advance(1500)
+  return room
+}
+
+function consistent (room, a, b) {
+  const pa = room.pc(a, b)
+  const pb = room.pc(b, a)
+  if (!pa || !pb) return { ok: false, why: 'bağlantı yok' }
+  const ma = pa.ml.map((t) => t.kind + ':' + t.mid).join(',')
+  const mb = pb.ml.map((t) => t.kind + ':' + t.mid).join(',')
+  const ok = pa.signalingState === 'stable' && pb.signalingState === 'stable' && ma === mb && pa.connectionState === 'connected' && pb.connectionState === 'connected'
+  return { ok, a: [pa.signalingState, pa.connectionState, ma], b: [pb.signalingState, pb.connectionState, mb] }
+}
+
+// B'nin A ile oyun bağını açar ve iki tarafta açılmasını bekler
+async function openLink (room) {
+  const A = room.engines.A
+  const B = room.engines.B
+  assert.equal(B.voice.openGameLink(A.peerId), 'ok')
+  await room.advance(500)
+  assert.equal(B.voice.gameLinkState(A.peerId), 'open')
+  assert.equal(A.voice.gameLinkState(B.peerId), 'open')
+}
+
+function noNegotiationErrors (room, name) {
+  const e = room.engines[name]
+  assert.deepEqual(e.screen.filter((ev) => ev.type === 'error').map((ev) => ev.code), [], name + ' ekran hatası')
+  assert.deepEqual(e.camera.map((ev) => ev.code), [], name + ' kamera hatası')
+}
