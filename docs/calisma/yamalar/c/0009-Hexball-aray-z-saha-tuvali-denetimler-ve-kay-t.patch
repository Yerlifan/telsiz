+
+function hexballOnPointerEnd (e) {
+  const tc = hexballState.touch
+  let changed = false
+  if (e.pointerId === tc.pointer) {
+    tc.pointer = null
+    tc.x = 0
+    tc.y = 0
+    if (hexballState.kit) hexballState.kit.knob.style.transform = ''
+    changed = true
+  }
+  if (e.pointerId === tc.kickPointer) {
+    tc.kick = false
+    tc.kickPointer = null
+    changed = true
+  }
+  if (changed) hexballPushInput()
+}
