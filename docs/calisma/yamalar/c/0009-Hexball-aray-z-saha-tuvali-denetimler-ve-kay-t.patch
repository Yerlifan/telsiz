+          for (const m of css.slice(i + 1, j - 1).matchAll(/(--[a-z0-9-]+)\s*:\s*([^;]+);/g)) decls[m[1]] = m[2].trim()
+          out.push({ selectors: prelude.split(',').map((s) => s.trim()), decls })
+        }
